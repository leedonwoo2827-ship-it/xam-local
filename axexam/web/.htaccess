# /www/.htaccess — 루트를 문제집 포털로 보낸다
#
# ⚠⚠ 서버에 이미 .htaccess 가 있으면 **덮어쓰지 말고 이 내용을 아래에 붙여넣는다.**
#    FileZilla 에서 서버(S) → 강제로 숨김 파일 보이기 를 켜야 보인다.
#    (참고: 브라우저에서 /.htaccess 가 403 이 나는 건 파일 존재의 증거가 아니다 —
#     아파치가 .ht 로 시작하는 이름을 존재 여부와 무관하게 막는다. 실측 확인함.)
#
# 왜 index.php 를 안 고치고 여기서 하나:
#   index.php 는 그누보드 코어 파일이라 업데이트 때 덮어써진다.
#   .htaccess 는 배포본에 없으므로 우리 것이 살아남는다.
#
# 검증: https://axexam.mycafe24.com/ → /exam/ 로 301
#       /adm/ · /bbs/login.php · /exam/ 은 그대로 열려야 한다

# ⚠ 301(영구)이 아니라 302(임시)를 쓴다.
#   301 은 브라우저가 영구 캐시한다 — 한 번 뿌리면 방문자 쪽에서 되돌릴 방법이 없고,
#   주소창 자동완성이 도메인만 잡을 때 캐시된 301 로 튀어 /bbs/register.php 같은
#   멀쩡한 주소가 안 열리는 것처럼 보인다(실제로 겪음).
#   주소 구조가 아직 바뀔 수 있으므로(커스텀 도메인, 상세 페이지 추가) 확정 전까지는 302.
#   구조가 굳으면 R=302 → R=301 로 올린다. SEO 상 영구 이전을 알리는 건 그때다.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 루트에 정확히 일치할 때만 보낸다.
    # ^$ 라서 /adm/ · /bbs/ · /exam/ · /js/ 같은 하위 경로는 건드리지 않는다.
    RewriteRule ^$ /exam/ [R=302,L]

    # 카페24 자동설치가 남긴 기본 안내 페이지도 같이 막는다.
    RewriteRule ^hosting_index\.html$ /exam/ [R=302,L]
</IfModule>

# mod_rewrite 가 없는 경우의 폴백 — 디렉터리 인덱스 우선순위를 바꾼다.
# (있어도 무해하다. RewriteRule 이 먼저 걸리면 여기까지 오지 않는다.)
<IfModule mod_dir.c>
    DirectoryIndex index.php index.html
</IfModule>
