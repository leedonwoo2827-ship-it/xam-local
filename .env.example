# XAM LOCAL 설정 — 이 파일을 .env 로 복사해서 쓴다.
# 메모장으로 저장해도 되도록 app.py 가 utf-8-sig 로 읽는다(BOM 허용).

# ── 외부 트리 ────────────────────────────────────────────────────────────────
# 도구 #1(exam-ocr-tool)의 산출물 트리. 00/ 01/ 02/ 03/ 04/ 05/ 06/ _rounds/
XAM_BOOK=D:\00work\ocr-output-260730

# 도구 #3(chodangi-mp4-forge). make_bundle_video.py 를 이 폴더에서 실행한다.
XAM_CHODANGI=D:\00work\chodangi-mp4-forge-main

# 웹(그누보드5) 저장소. scripts/build_check.py 를 여기서 호출한다.
#   git clone https://github.com/leedonwoo2827-ship-it/axexam _ref\axexam
XAM_AXEXAM=_ref\axexam

# ── 품목 ────────────────────────────────────────────────────────────────────
# ★ ex_product.pd_id 이자 URL 의 ?pd= 값. build_check.py 의 기본값은 'sqld' 이므로
#   이 값을 반드시 명시해야 라이브 SQLD 문제은행을 덮어쓰는 사고를 막는다.
#   소문자·숫자·하이픈 20자 이내(언더바 불가).
XAM_PD=bigdata
XAM_PD_LABEL=빅데이터분석기사 필기

# ── 웹 ──────────────────────────────────────────────────────────────────────
XAM_SITE=https://axexam.mycafe24.com
XAM_SITE_PATH=exam

# ── 로컬 ────────────────────────────────────────────────────────────────────
XAM_PORT=8870
XAM_JOB_HISTORY=200
XAM_LOG_TAIL=400
